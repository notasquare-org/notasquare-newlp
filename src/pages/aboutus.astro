---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company } from '../data/company';
const title = `Not a Square｜会社概要`;
const description = `株式会社Not a Square（NaS）の会社概要、理念、共同創業者をご紹介します。`;

const members = [
  {
    name: '酒井涼雅',
    role: 'CEO',
    photo: '/uploads/member-sakai.jpg',
    before:
      'アプリ制作の全国大会「アプリ甲子園」（現：テック甲子園）で企業賞を受賞。その経験を生かし、個人事業として1年以上にわたり中小企業向けの受託開発サービスを展開してきました。AIコンサルティング会社でのインターンや個人でのAI相談を通じ、AIの進歩を現場へ届ける人材が不足していることを実感。現場主義の実装と運用には、エンジニアリングとコンサルティングの知見を併せ持つ組織が必要だと考え、人・現場課題・AIの循環を生み出すNot a Squareを創業しました。',
    atNas:
      '共同創業者／CEOとしてNaSのビジョンを描き、事業執行、技術方針、システム開発、品質、情報セキュリティを統括します。生まれ育った関西を起点に、徹底した現場主義で人々の可能性を広げるAI運用のプロフェッショナル組織をつくります。',
  },
  {
    name: '御幡アルバート武嗣',
    role: 'COO',
    photo: '/uploads/member-albert.webp',
    before:
      'Boston University卒業後、Google広告営業本部でデジタルマーケティング・広告領域、FGS GlobalでM&Aや企業コミュニケーション、外資系投資銀行で株式・デリバティブ領域の業務を経験しました。会社員として働く一方、2024年にA&A Co.を立ち上げ、学生メンバーとデジタル戦略やAIを活用した事業づくりに取り組みました。生成AIの急速な進化と、関西の中小企業が抱える導入・業務活用のギャップを実感し、目指す方向を同じくするNaSへA&Aの活動を引き継ぐ形で合流しました。',
    atNas:
      '共同創業者／COOとして、顧客戦略と事業戦略を中心に担当します。生成AIやAIエージェントの導入自体を目的にせず、実際の業務改善と生産性向上につなげることを重視。テクノロジー、金融、M&A、事業づくりの経験を生かし、顧客対応、事業設計、契約・パートナーシップ、広報などを横断して担います。',
  },
  {
    name: '佐伯勇樹',
    role: 'CCO',
    photo: '/uploads/member-saeki.webp',
    before:
      'AIコンサルティング会社でインターンとして働き、進化を続けるAIをより広い範囲へ届けるため、自身の影響力を高められる新たな環境で挑戦したいと考えていました。大学のゼミのLINEグループでNot a Squareのメンバー募集を知り、自分の課題意識と重なると感じてすぐに代表の酒井へ連絡し、NaSに合流しました。',
    atNas:
      '共同創業者／CCOとして、営業・マーケティングを中心に担当します。顧客セグメント設計、顧客開拓、インタビュー、課題に応じた方針提案、営業予測まで、顧客との接点づくりを幅広く担当。顧客の声をサービスやコンテンツへ還元し、NaSと関西の中小企業をつなぐ、継続的な事業成長の仕組みをつくります。',
  },
];
---

<BaseLayout title={title} description={description} active="aboutus" breadcrumb={[{ name: '概要' }]}>

<section class="page-hero">
  <div class="container">
    <div class="en hero-anim">ABOUT US</div>
    <h1 class="hero-anim d1">概要</h1>
    <div class="breadcrumb hero-anim d2"><a href="/">ホーム</a> ／ 概要</div>
  </div>
</section>

<!-- ===== MISSION ===== -->
<section class="sec mvv mvv-left">
  <div class="container">
    <div class="mvv-stage reveal">
      <div class="mvv-word" aria-hidden="true">
        <img class="mvv-mark" src="/uploads/titleogo.png" alt="">
        <span>Mission</span>
      </div>
      <div class="mvv-card">
        <div class="mvv-en">MISSION</div>
        <h2 class="mvv-title">すべての挑戦者に、<br>自己実現の為の「余白」を創る</h2>
      </div>
    </div>
  </div>
</section>

<!-- ===== VISION ===== -->
<section class="sec sec-light mvv mvv-right">
  <div class="container">
    <div class="mvv-stage reveal">
      <div class="mvv-word" aria-hidden="true">
        <span>Vision</span>
        <img class="mvv-mark" src="/uploads/titleogo.png" alt="">
      </div>
      <div class="mvv-card">
        <div class="mvv-en">VISION</div>
        <h2 class="mvv-title vision-title">
          <span class="vision-desktop-copy">2030年、日本で一番信頼される<br>FDE企業になり、すべての関わる人が<br>自己実現できる社会を創る。</span>
          <span class="vision-mobile-copy">2030年、日本で一番信頼されるFDE企業になり、<br>すべての関わる人が自己実現できる社会を創る。</span>
        </h2>
      </div>
    </div>
  </div>
</section>

<!-- ===== VALUE ===== -->
<section class="sec mvv mvv-left">
  <div class="container">
    <div class="mvv-stage reveal">
      <div class="mvv-word" aria-hidden="true">
        <img class="mvv-mark" src="/uploads/titleogo.png" alt="">
        <span>Value</span>
      </div>
      <div class="mvv-card">
        <div class="mvv-en">VALUE</div>
        <h2 class="mvv-title">私たちが大切にする<br>3つの価値観</h2>
        <div class="mvv-vlist">
          <div class="mvv-vrow">
            <span class="mvv-vno">01</span>
            <div class="mvv-vmain">
              <div class="mvv-vtitle">現場で証明しろ</div>
              <p class="mvv-vdesc">提案書ではなく、顧客の隣で動くことで価値を示す。机上の空論ではなく、現場で動く仕組みと数字で成果を証明します。</p>
            </div>
          </div>
          <div class="mvv-vrow">
            <span class="mvv-vno">02</span>
            <div class="mvv-vmain">
              <div class="mvv-vtitle">信頼を雪だるまにしろ</div>
              <p class="mvv-vdesc">一つの成果が次の信頼を呼ぶ。約束を超える成果だけが信頼を複利で増やす。</p>
            </div>
          </div>
          <div class="mvv-vrow">
            <span class="mvv-vno">03</span>
            <div class="mvv-vmain">
              <div class="mvv-vtitle">枠に収まるな（Not a Square）</div>
              <p class="mvv-vdesc">既存の常識・業界の枠・年齢の壁、すべてを超えて挑戦する。社名「Not a Square」の語源そのものです。</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style is:inline>
    /* ===== MISSION / VISION / VALUE 共通（大きな背景ワード＋ロゴ＋カード） ===== */
    .mvv{overflow:hidden}
    .mvv-stage{position:relative;max-width:1040px;margin:0 auto;min-height:540px}
    /* ロード（スクロールで表示）時に左右からスライドインさせる */
    .mvv .mvv-stage.reveal{opacity:0;transition:opacity .9s cubic-bezier(.2,.7,.2,1),transform .9s cubic-bezier(.2,.7,.2,1)}
    .mvv-left .mvv-stage.reveal{transform:translateX(-72px)}
    .mvv-right .mvv-stage.reveal{transform:translateX(72px)}
    .mvv .mvv-stage.reveal.is-visible{opacity:1;transform:none}
    @media(prefers-reduced-motion:reduce){
      .mvv-left .mvv-stage.reveal,.mvv-right .mvv-stage.reveal{transform:none}
    }
    /* 背景の大きな英字＋ロゴ。カードの上端にだけ重なり、文字全体は読めるよう配置 */
    .mvv-word{display:flex;width:100%;align-items:center;gap:18px;user-select:none;pointer-events:none;font-family:var(--font-display);font-weight:800;font-size:clamp(56px,8.5vw,112px);line-height:1;letter-spacing:.01em;color:#ecebe7}
    .mvv-left .mvv-word{justify-content:flex-start;margin-left:-48px}
    .mvv-right .mvv-word{justify-content:flex-end;margin-right:-48px}
    .mvv-mark{height:clamp(34px,4.6vw,54px);width:auto;flex:none}
    /* 大ワードの下に並べるテキスト群（重ならない／箱なし） */
    .mvv-card{background:transparent;border:none;border-radius:0;padding:0;max-width:760px;box-shadow:none}
    .mvv-left .mvv-card{margin:clamp(14px,2.4vw,28px) 0 0 auto}
    .mvv-right .mvv-card{margin:clamp(14px,2.4vw,28px) auto 0 0;text-align:right}
    .mvv-en{font-family:var(--font-display);font-size:13px;font-weight:700;letter-spacing:.18em;color:#8fc0c2;margin-bottom:18px}
    .mvv-title{font-size:clamp(24px,3.4vw,33px);font-weight:700;color:#2a2f37;line-height:1.5;letter-spacing:.01em;margin:0 0 30px}
    .vision-mobile-copy{display:none}
    .mvv-body p{font-size:15px;color:#3A3F47;line-height:2.1;margin:0 0 14px}
    .mvv-body p:last-child{margin-bottom:0}
    /* VALUE：カード内の3項目リスト */
    .mvv-vlist{display:flex;flex-direction:column;gap:28px}
    .mvv-vrow{display:flex;gap:20px;align-items:flex-start;text-align:left}
    .mvv-vno{flex:none;font-family:var(--font-display);font-size:24px;font-weight:800;color:#8fc0c2;line-height:1.5;min-width:36px}
    .mvv-vtitle{font-size:18px;font-weight:700;color:#2a2f37;margin-bottom:9px}
    .mvv-vdesc{font-size:14px;color:#3A3F47;line-height:1.95;margin:0}
    @media(max-width:760px){
      .mvv-stage{min-height:0}
      .mvv-word{margin-left:0 !important;margin-right:0 !important;opacity:.9}
      .mvv-left .mvv-word{justify-content:flex-start !important}
      .mvv-right .mvv-word{justify-content:flex-end !important}
      .mvv-left .mvv-card{margin:14px 0 0;text-align:left}
      .mvv-right .mvv-card{margin:14px 0 0;text-align:right}
    }
    @media(max-width:520px){
      .vision-desktop-copy{display:none}
      .vision-mobile-copy{display:block;white-space:nowrap}
      .mvv-title{font-size:clamp(11px,calc((100vw - 40px) * .04),15px);letter-spacing:0;line-height:1.8}
    }
  </style>
</section>

<!-- ===== MEMBER ===== -->
<section class="sec sec-light">
  <div class="container">
    <div class="sec-head reveal">
      <div class="sec-en sm">CO-FOUNDERS</div>
      <div class="sec-jp">共同創業者</div>
      <div class="sec-rule"></div>
    </div>
    <div class="member-switcher" data-member-switcher>
      <div class="member-carousel reveal">
        <div class="member-carousel-controls" aria-label="共同創業者カードのスライド操作">
          <button class="member-carousel-button" type="button" aria-label="前のメンバーを表示" data-member-prev>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
          </button>
          <button class="member-carousel-button" type="button" aria-label="次のメンバーを表示" data-member-next>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
          </button>
        </div>
        <div class="member-tabs" aria-label="共同創業者一覧" data-member-track>
          {members.map((member, index) => (
            <button
              class="member-tab"
              type="button"
              id={`member-tab-${index}`}
              aria-haspopup="dialog"
              aria-controls="member-modal"
              aria-expanded="false"
              data-member-tab={String(index)}
            >
              <span class="member-card">
                <img src={member.photo} alt="" loading="lazy" />
                <span class="member-overlay">
                  <span class="member-role">{member.role}</span>
                  <span class="member-name">{member.name}</span>
                </span>
              </span>
            </button>
          ))}
        </div>
      </div>

      <div class="member-modal" id="member-modal" data-member-modal hidden>
        <div class="member-modal-dialog" role="dialog" aria-modal="true" tabindex="-1" data-member-dialog>
          <button class="member-modal-close" type="button" aria-label="メンバー詳細を閉じる" data-member-close>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
          </button>
          <div class="member-panels">
            {members.map((member, index) => (
              <article
                class="member-panel"
                id={`member-panel-${index}`}
                aria-labelledby={`member-panel-title-${index}`}
                hidden
                data-member-panel={String(index)}
              >
                <div class="member-detail-photo">
                  <img src={member.photo} alt={`${member.name}のプロフィール写真`} loading={index === 0 ? 'eager' : 'lazy'} />
                </div>
                <div class="member-copy">
                  <div class="member-detail-heading">
                    <span>{member.role}</span>
                    <h2 id={`member-panel-title-${index}`}>{member.name}</h2>
                  </div>
                  <div class="member-copy-section">
                    <h3>NaSに入るまで</h3>
                    <p>{member.before}</p>
                  </div>
                  <div class="member-copy-section">
                    <h3>NaSで行う業務</h3>
                    <p>{member.atNas}</p>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:inline>
  .member-switcher{max-width:960px;margin:0 auto}
  .member-carousel{position:relative}
  .member-carousel-controls{display:flex;justify-content:flex-end;gap:10px;margin-bottom:18px}
  .member-carousel-button{appearance:none;display:grid;width:44px;height:44px;place-items:center;border:1px solid #cad5e3;border-radius:50%;background:#fff;color:#14233F;cursor:pointer;transition:background .25s,border-color .25s,color .25s,opacity .25s}
  .member-carousel-button:hover:not(:disabled){border-color:#5b9da0;background:#5b9da0;color:#fff}
  .member-carousel-button:focus-visible{outline:3px solid rgba(50,123,180,.35);outline-offset:3px}
  .member-carousel-button:disabled{opacity:.3;cursor:default}
  .member-carousel-button svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .member-tabs{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 56px)/3);gap:28px;align-items:start;overflow-x:auto;overscroll-behavior-inline:contain;scroll-behavior:smooth;scroll-snap-type:inline mandatory;scrollbar-width:none;padding:6px 2px 24px}
  .member-tabs::-webkit-scrollbar{display:none}
  .member-tab{appearance:none;display:block;width:100%;padding:0;border:2px solid transparent;border-radius:18px;background:transparent;color:inherit;text-align:left;cursor:pointer;scroll-snap-align:start;transition:transform .3s cubic-bezier(.2,.7,.2,1),border-color .3s,box-shadow .3s}
  .member-tab:hover{transform:translateY(-5px)}
  .member-tab:focus-visible{outline:3px solid rgba(50,123,180,.35);outline-offset:4px}
  .member-tab[aria-expanded="true"]{transform:translateY(-5px);border-color:#8fc0c2;box-shadow:0 16px 34px rgba(16,32,63,.15)}
  .member-card{display:block;position:relative;border-radius:15px;overflow:hidden;aspect-ratio:4/5;background:linear-gradient(160deg,#F4F7FE,#dbe5f4)}
  .member-card img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block;transition:transform .45s cubic-bezier(.2,.7,.2,1)}
  .member-tab:hover .member-card img,.member-tab[aria-expanded="true"] .member-card img{transform:scale(1.025)}
  .member-overlay{position:absolute;left:0;right:0;bottom:0;display:block;padding:64px 20px 20px;background:linear-gradient(180deg,rgba(16,32,63,0),rgba(16,32,63,.84));color:#fff}
  .member-role{display:block;font-family:var(--font-display);font-size:12px;font-weight:800;letter-spacing:.14em;color:#8ed2ef;margin-bottom:7px;line-height:1.4}
  .member-name{display:block;font-size:20px;font-weight:700;line-height:1.3}
  .member-modal{position:fixed;inset:0;z-index:3000;display:grid;place-items:center;padding:24px;background:rgba(10,22,43,.7);backdrop-filter:blur(8px);animation:member-modal-in .25s ease-out}
  .member-modal[hidden]{display:none}
  .member-modal-dialog{position:relative;width:min(1120px,100%);max-height:calc(100dvh - 48px);overflow:auto;border-radius:22px;background:#fff;box-shadow:0 30px 90px rgba(3,15,34,.3);outline:none}
  .member-modal-close{appearance:none;position:absolute;z-index:2;top:16px;right:16px;display:grid;width:44px;height:44px;place-items:center;border:1px solid #d7dee8;border-radius:50%;background:rgba(255,255,255,.94);color:#14233F;cursor:pointer;transition:background .2s,color .2s,transform .2s}
  .member-modal-close:hover{background:#14233F;color:#fff;transform:rotate(4deg)}
  .member-modal-close:focus-visible{outline:3px solid rgba(50,123,180,.35);outline-offset:3px}
  .member-modal-close svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round}
  .member-panels{margin:0}
  .member-panel{grid-template-columns:minmax(280px,380px) minmax(0,1fr);gap:clamp(32px,5vw,62px);align-items:center;padding:clamp(30px,4vw,52px);border-radius:22px;background:#fff;animation:member-panel-in .4s cubic-bezier(.2,.7,.2,1)}
  .member-panel:not([hidden]){display:grid}
  .member-panel[hidden]{display:none}
  .member-detail-photo{overflow:hidden;aspect-ratio:1/1;border-radius:16px;background:linear-gradient(160deg,#F4F7FE,#dbe5f4)}
  .member-detail-photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:center top}
  .member-copy{min-width:0}
  .member-detail-heading{margin-bottom:28px}
  .member-detail-heading span{display:block;font-family:var(--font-display);font-size:13px;font-weight:800;letter-spacing:.16em;color:#5b9da0;margin-bottom:7px}
  .member-detail-heading h2{font-size:clamp(24px,3vw,32px);font-weight:700;line-height:1.35;color:#14233F;margin:0}
  .member-copy-section+.member-copy-section{margin-top:26px}
  .member-copy h3{font-size:15px;font-weight:700;color:#14233F;margin:0 0 10px;padding-left:11px;border-left:3px solid #8fc0c2}
  .member-copy p{font-size:14px;color:#3c4658;line-height:2;margin:0}
  body.member-modal-open{overflow:hidden}
  @keyframes member-modal-in{from{opacity:0}to{opacity:1}}
  @keyframes member-panel-in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  @media(max-width:900px){
    .member-tabs{grid-auto-columns:calc((100% - 32px)/3);gap:16px}
    .member-panel{grid-template-columns:minmax(220px,300px) minmax(0,1fr);gap:30px}
    .member-overlay{padding:50px 16px 16px}
    .member-name{font-size:17px}
  }
  @media(max-width:640px){
    .member-carousel-controls{margin-bottom:12px}
    .member-carousel-button{width:40px;height:40px}
    .member-tabs{grid-auto-columns:68%;gap:12px;padding-bottom:18px;scroll-padding-inline:2px}
    .member-tab{border-radius:12px}
    .member-card{border-radius:10px}
    .member-overlay{padding:36px 9px 10px}
    .member-role{font-size:10px;margin-bottom:4px}
    .member-name{font-size:clamp(12px,3.6vw,16px)}
    .member-modal{padding:12px}
    .member-modal-dialog{max-height:calc(100dvh - 24px);border-radius:16px}
    .member-modal-close{top:10px;right:10px;width:40px;height:40px}
    .member-panel{grid-template-columns:1fr;gap:24px;padding:18px;padding-top:64px;border-radius:16px;align-items:start}
    .member-detail-photo{width:min(360px,100%);margin:0 auto}
    .member-detail-heading{margin-bottom:23px}
    .member-copy p{font-size:13.5px;line-height:1.95}
  }
  @media(prefers-reduced-motion:reduce){
    .member-tab,.member-card img,.member-tabs{transition:none;scroll-behavior:auto}
    .member-panel,.member-modal{animation:none}
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-member-switcher]').forEach((switcher) => {
    const tabs = Array.from(switcher.querySelectorAll<HTMLButtonElement>('[data-member-tab]'));
    const panels = Array.from(switcher.querySelectorAll<HTMLElement>('[data-member-panel]'));
    const modal = switcher.querySelector<HTMLElement>('[data-member-modal]');
    const dialog = switcher.querySelector<HTMLElement>('[data-member-dialog]');
    const closeButton = switcher.querySelector<HTMLButtonElement>('[data-member-close]');
    const track = switcher.querySelector<HTMLElement>('[data-member-track]');
    const prevButton = switcher.querySelector<HTMLButtonElement>('[data-member-prev]');
    const nextButton = switcher.querySelector<HTMLButtonElement>('[data-member-next]');
    let lastTrigger: HTMLButtonElement | null = null;

    const openMember = (index: number) => {
      if (!modal || !dialog) return;
      lastTrigger = tabs[index] ?? null;
      tabs.forEach((tab, tabIndex) => {
        tab.setAttribute('aria-expanded', String(tabIndex === index));
      });
      panels.forEach((panel, panelIndex) => {
        panel.hidden = panelIndex !== index;
      });
      const activePanel = panels[index];
      if (activePanel) dialog.setAttribute('aria-labelledby', activePanel.getAttribute('aria-labelledby') ?? '');
      modal.hidden = false;
      document.body.classList.add('member-modal-open');
      requestAnimationFrame(() => closeButton?.focus());
    };

    const closeMember = () => {
      if (!modal || modal.hidden) return;
      modal.hidden = true;
      document.body.classList.remove('member-modal-open');
      tabs.forEach((tab) => tab.setAttribute('aria-expanded', 'false'));
      panels.forEach((panel) => { panel.hidden = true; });
      lastTrigger?.focus();
    };

    const updateCarouselButtons = () => {
      if (!track || !prevButton || !nextButton) return;
      const maxScroll = track.scrollWidth - track.clientWidth;
      prevButton.disabled = track.scrollLeft <= 2;
      nextButton.disabled = track.scrollLeft >= maxScroll - 2;
    };

    const slideCards = (direction: number) => {
      if (!track) return;
      const firstCard = track.querySelector<HTMLElement>('[data-member-tab]');
      const styles = getComputedStyle(track);
      const gap = Number.parseFloat(styles.columnGap || styles.gap) || 0;
      track.scrollBy({ left: direction * ((firstCard?.offsetWidth ?? track.clientWidth) + gap), behavior: 'smooth' });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => openMember(index));
    });

    closeButton?.addEventListener('click', closeMember);
    modal?.addEventListener('click', (event) => {
      if (event.target === modal) closeMember();
    });
    modal?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeMember();
        return;
      }
      if (event.key !== 'Tab' || !dialog) return;
      const focusable = Array.from(dialog.querySelectorAll<HTMLElement>('button:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])'))
        .filter((element) => !element.hasAttribute('hidden'));
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    prevButton?.addEventListener('click', () => slideCards(-1));
    nextButton?.addEventListener('click', () => slideCards(1));
    track?.addEventListener('scroll', updateCarouselButtons, { passive: true });
    window.addEventListener('resize', updateCarouselButtons);
    updateCarouselButtons();
  });
</script>

