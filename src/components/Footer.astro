---
import { company } from '../data/company';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-brand-row">
          <a href="/" class="footer-logo"><img src="/uploads/footer_logo.png" alt="Not a Square"></a>
          <div class="footer-social-links" aria-label="公式SNS">
            <a href="https://www.instagram.com/nas___inc/" target="_blank" rel="noopener noreferrer" aria-label="Instagram（新しいタブで開く）">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle class="footer-social-dot" cx="17.5" cy="6.5" r="1" />
              </svg>
            </a>
            <a href="https://x.com/notasquare_ai" target="_blank" rel="noopener noreferrer" aria-label="X（新しいタブで開く）">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 4l14 16M19 4L5 20" />
              </svg>
            </a>
          </div>
        </div>
        <div class="addr">
          {company.name}（{company.shortName}）<br>
          〒{company.address.postalCode}<br>
          {company.address.addressRegion}{company.address.addressLocality}{company.address.streetAddress}<br>
          京阪神および関西一円に対応
        </div>
      </div>
      <div class="footer-cols">
        <div class="footer-col">
          <div class="h">会社情報</div>
          <a href="/aboutus">概要</a>
          <a href="/service/">事業内容</a>
          <a href="/record">実績</a>
        </div>
        <div class="footer-col">
          <div class="h">サポート</div>
          <a href="/news">お知らせ</a>
          <a href="/download">資料ダウンロード</a>
          <a href="/consultation">無料相談</a>
        </div>
        <div class="footer-col">
          <div class="h">お問い合わせ</div>
          <a href="/contact">問い合わせ</a>
          <a href="/privacy">プライバシーポリシー</a>
          <a href="/security-policy">情報セキュリティ基本方針</a>
        </div>
      </div>
    </div>
    <div class="copy">© Not a Square. All Rights Reserved.</div>
  </div>
</footer>
